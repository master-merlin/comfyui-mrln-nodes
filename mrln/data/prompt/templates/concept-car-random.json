{
  "version": 1,
  "label": "Concept Car (randomized)",
  "description": "Heavy-randomization template; queue with incrementing seed for endless variations.",
  "prefix": "High-resolution photo, {advertisement|editorial} style, unique futuristic concept car, cinematic lighting, HDR quality.",
  "suffix": "Hyperrealistic material textures (carbon weave, metal, glass, tires). Sharp highlights, deep shadows define form.",
  "negative": "text, watermark, cartoon, render artifacts",
  "slots": [
    {
      "id": "dna",
      "ref": "car/model",
      "label": "Core DNA",
      "default": "random"
