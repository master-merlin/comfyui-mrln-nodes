    {
      "id": "paint",
      "ref": "car/color/paint",
      "label": "Primary Body",
      "default": "random"
    },
    {
      "id": "finish",
      "ref": "car/finish",
      "label": "Finish",
      "default": "random"
    },
    {
      "id": "accent",
      "ref": "car/color/accent",
      "label": "Contrast Elements",
      "default": "random"
    },
    {
      "id": "highlight",
      "ref": "car/color/accent",
      "label": "Minor Highlights",
      "default": "random"
    },
    {
      "id": "aero",
      "ref": "car/aero-addon",
      "label": "Aero Add-on",
      "default": "random",
      "allow_empty": true,
      "empty_weight": 1.0
    },
    {
      "id": "plate",
      "ref": "car/detail",
      "label": "Detail",
      "default": "overdrive-plate",
      "emphasis": 1.2
