        },
        {
          "id": "lighting",
          "ref": "lighting",
          "label": "Lighting",
          "default": "studio-softbox"
        }
      ]
    },
    {
      "name": "outdoor",
      "label": "Outdoor",
      "slots": [
        {
          "id": "location",
          "ref": "location",
          "label": "Setting",
          "default": "random"
        },
        {
          "id": "lighting",
          "ref": "lighting",
          "label": "Lighting",
          "default": "random"
        },
        {
          "id": "atmosphere",
          "ref": "atmosphere",
          "label": "Atmosphere",
          "default": "random"
        }
      ]
    }
  ],
  "variant_default": "random",
  "order": [
    "dna",
    "paint",
    "finish",
    "accent",
    "highlight",
    "aero",
    "plate",
    "@variant"
