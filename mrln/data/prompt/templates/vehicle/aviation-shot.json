{
  "version": 1,
  "label": "Aviation Shot",
  "type": ["object", "vehicle", "aircraft"],
  "description": "Aviation photography: aircraft type and state under big skies with long glass.",
  "prefix": "A highly realistic aviation photograph.",
  "slots": [
    {
      "id": "quality",
      "ref": "style/quality",
      "label": "Quality boost",
      "default": "photoreal-raw"
    },
    {
      "id": "aircraft",
      "ref": "vehicle/aircraft/type",
      "label": "Aircraft",
      "emphasis": 1.2
    },
    {
      "id": "state",
      "ref": "vehicle/aircraft/state",
      "label": "Flight state",
      "emphasis": 1.15
    },
    {
      "id": "sky",
      "ref": "atmosphere/weather",
      "label": "Sky"
    },
    {
      "id": "time",
      "ref": "atmosphere/time-of-day",
      "label": "Time of day"
    },
    {
      "id": "lens",
      "ref": "camera/lens",
      "label": "Lens",
      "default": "600mm-telephoto"
    },
    {
      "id": "film",
      "ref": "camera/film",
      "label": "Film look",
      "allow_empty": true
    },
    {
      "id": "framing",
      "ref": "composition/framing",
      "label": "Composition",
      "allow_empty": true
    }
  ],
  "suffix": "crisp panel lines and rivet detail, rotor and propeller motion handled naturally, sharp focus on the aircraft",
  "negative": "watermark, text, logo, deformed geometry",
  "render": {
    "format": "string",
    "joiner": ", "
  }
}
