{
  "version": 1,
  "label": "Night Ride",
  "type": ["object", "vehicle", "car"],
  "description": "Neon-noir car photography: night places, CineStill halation, parked or rolling via variants.",
  "prefix": "A cinematic night automotive photograph.",
  "variables": [
    { "name": "trigger", "label": "Car / LoRA trigger", "default": "a sleek performance car" }
  ],
  "slots": [
    { "id": "quality", "ref": "style/quality", "label": "Quality boost", "default": "photoreal-raw" },
    { "id": "paint", "ref": "vehicle/car/color/paint", "label": "The {trigger} wears", "emphasis": 1.15 },
    { "id": "scene", "ref": "location", "label": "Night scene", "tags_any": ["night"], "emphasis": 1.25 },
    { "id": "light", "ref": "lighting/dramatic", "label": "Light", "default": "neon-rim" },
    { "id": "film", "ref": "camera/film", "label": "Film look", "default": "cinestill-800t" }
  ],
  "variants": [
    {
      "name": "parked",
      "label": "Parked / simmering",
      "slots": [
        { "id": "state", "ref": "vehicle/car/state", "label": "State", "default": "lights-on" },
        { "id": "technique", "ref": "camera/technique", "label": "Technique", "default": "underexposed-moody" }
      ]
    },
    {
      "name": "rolling",
      "label": "Rolling / motion",
      "slots": [
        { "id": "action", "ref": "vehicle/car/action", "label": "Motion" },
        { "id": "technique", "ref": "camera/technique", "label": "Technique", "default": "motion-panning" }
      ]
    }
  ],
  "variant_default": "random",
  "suffix": "wet asphalt reflections doubling every light source, sharp focus on the {trigger}",
  "negative": "daylight, overcast flatness, watermark, text",
  "render": { "format": "string", "joiner": ", " }
}
