{
  "version": 1,
  "label": "Night Ride",
  "type": ["object", "vehicle", "car"],
  "description": "Neon-noir car photography: curated night roads, night glass and night film, parked or rolling via variants.",
  "prefix": "A cinematic night automotive photograph with the texture of a real frame, deep blacks and honest grain, practical light doing the work",
  "variables": [
    { "name": "trigger", "label": "Car / LoRA trigger", "default": "sleek performance car" }
  ],
  "slots": [
    { "id": "paint", "ref": "vehicle/car/color/paint", "label": "The {trigger} wears", "emphasis": 1.15 },
    { "id": "scene", "ref": "vehicle/stage/night-road", "label": "Night scene", "emphasis": 1.25 },
    { "id": "light", "ref": "lighting/dramatic", "label": "Light", "tags_any": ["night"], "default": "neon-rim" },
    { "id": "film", "ref": "camera/film", "label": "Film look", "tags_any": ["night"], "default": "cinestill-800t" }
  ],
  "variants": [
    {
      "name": "parked",
      "label": "Parked / simmering",
      "slots": [
        { "id": "state", "ref": "vehicle/car/state", "label": "State", "default": "lights-on" },
        { "id": "technique", "ref": "vehicle/craft/rig", "label": "Technique", "tags_any": ["static"], "default": "underexposed-practicals" }
      ]
    },
    {
      "name": "rolling",
      "label": "Rolling / motion",
      "slots": [
        { "id": "action", "ref": "vehicle/car/action", "label": "Motion", "tags_any": ["smooth-motion", "aggressive-dynamics"] },
        { "id": "technique", "ref": "vehicle/craft/rig", "label": "Technique", "tags_any": ["motion"], "default": "panning-telephoto" }
      ]
    }
  ],
  "variant_default": "random",
  "suffix": "wet asphalt reflections doubling every light source, sharp focus on the {trigger}",
  "negative": "daylight, overcast flatness, watermark, text",
  "render": { "format": "string", "joiner": ", " }
}
