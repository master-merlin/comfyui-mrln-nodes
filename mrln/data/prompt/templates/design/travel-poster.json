{
  "version": 1,
  "label": "Travel Poster",
  "description": "A destination distilled into a vintage travel poster — drawn per destination family, flavored by a real print process.",
  "prefix": "A vintage travel poster design — one destination distilled into flat confident shapes and a single unforgettable view, the kind commissioned by a golden-age railway company.",
  "variables": [
    { "name": "caption", "label": "Poster caption", "default": "VISIT" }
  ],
  "slots": [
    { "id": "print", "ref": "style/print", "label": "Print process", "default": "lithograph-vintage", "emphasis": 1.2 },
    { "id": "palette", "ref": "style/palette", "label": "Palette" },
    { "id": "season", "ref": "atmosphere/season", "label": "Season", "allow_empty": true },
    { "id": "framing", "ref": "composition/framing", "label": "Composition", "default": "horizon-low" }
  ],
  "variants": [
    {
      "name": "city-break",
      "label": "City break",
      "slots": [
        { "id": "destination", "ref": "location/urban", "label": "Destination", "emphasis": 1.3 }
      ]
    },
    {
      "name": "coastline",
      "label": "Coastline",
      "slots": [
        { "id": "destination", "ref": "location/coastal", "label": "Destination", "emphasis": 1.3 }
      ]
    },
    {
      "name": "countryside",
      "label": "Countryside",
      "slots": [
        { "id": "destination", "ref": "location/nature", "label": "Destination", "emphasis": 1.3 }
      ]
    },
    {
      "name": "japan",
      "label": "Japan",
      "slots": [
        { "id": "destination", "ref": "location/japan", "label": "Destination", "emphasis": 1.3 }
      ]
    },
    {
      "name": "storied-places",
      "label": "Storied places",
      "slots": [
        { "id": "destination", "ref": "location/historical", "label": "Destination", "emphasis": 1.3 }
      ]
    }
  ],
  "variant_default": "random",
  "order": ["@variant", "print", "palette", "season", "framing"],
  "suffix": "elegant retro title block reading \"{caption}\", flat confident poster shapes with clean registration, gallery-print quality",
  "negative": "photorealistic rendering, clutter, watermark",
  "render": { "format": "string", "joiner": ", " }
}
