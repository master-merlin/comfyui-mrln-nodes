{
  "version": 1,
  "label": "Product Hero",
  "type": ["product", "object"],
  "description": "Commercial hero shot: product, staging and studio light — the MIT-repo genre distilled.",
  "prefix": "A premium commercial product photograph.",
  "slots": [
    {
      "id": "quality",
      "ref": "style/quality",
      "label": "Quality boost",
      "default": "maximal-8k"
    },
    {
      "id": "product",
      "ref": "product/category",
      "label": "Product",
      "emphasis": 1.3
    },
    {
      "id": "staging",
      "ref": "product/staging",
      "label": "Staging",
      "emphasis": 1.2
    },
    {
      "id": "light",
      "ref": "lighting/studio",
      "label": "Studio light"
    },
    {
      "id": "palette",
      "ref": "style/palette",
      "label": "Palette",
      "allow_empty": true
    },
    {
      "id": "graphic",
      "ref": "style/graphic",
      "label": "Graphic treatment",
      "allow_empty": true,
      "empty_weight": 3.0
    },
    {
      "id": "lens",
      "ref": "camera/lens",
      "label": "Lens",
      "default": "100mm-macro"
    }
  ],
  "suffix": "flawless surface control, deliberate reflections, advertising-grade finish",
  "negative": "watermark, text, fingerprints, dust, scratches",
  "render": {
    "format": "string",
    "joiner": ", "
  }
}
