{
  "version": 1,
  "label": "Car Shoot",
  "description": "Labeled car-photography prompt in the example-01 shape. Set {trigger} to your subject or LoRA trigger word.",
  "prefix": "A highly realistic image of a {trigger}, in the center of the scene, stationary.",
  "suffix": "Micro-Details: hyper-detailed surfaces capturing textures, curves, reflections.",
  "negative": "cartoon, illustration, watermark, low quality",
  "variables": [
    {
      "name": "trigger",
      "label": "Subject trigger",
      "default": "modern sports car"
    }
  ],
  "slots": [
    {
      "id": "style",
      "ref": "style",
      "label": "Style & Color Scheme",
      "default": "vibrant-high-class"
    },
    {
      "id": "paint",
      "ref": "car/color/paint",
      "label": "Primary Car Color",
      "default": "carbon-grey-matte"
    },
    {
      "id": "viewpoint",
      "ref": "viewpoint",
      "label": "Viewing Angle & Composition",
      "default": "front-three-quarter"
    },
    {
      "id": "atmosphere",
      "ref": "atmosphere",
      "label": "Time of Day / Atmosphere",
      "default": "summer-sundown"
    },
    {
      "id": "lighting",
      "ref": "lighting",
      "label": "Lighting Conditions",
      "default": "hdr-cinematic"
    },
    {
      "id": "location",
      "ref": "location",
      "label": "Location",
      "default": "urban/shibuya-crossing"
    },
    {
      "id": "camera",
      "ref": "camera",
      "label": "Photographic Settings",
      "default": "tele-150mm-action"
    }
  ],
  "render": {
    "format": "string_labeled",
    "labeled_line": "{label}: {text}",
    "block_joiner": "\n"
  }
}
