{
  "version": 1,
  "label": "Intimate Landscape",
  "type": ["nature"],
  "description": "The quiet landscape genre: a small scene isolated by a long lens and weather, drawn per biome, closer to poetry than geography.",
  "prefix": "An intimate landscape photograph — not the grand vista but the quiet scene within it, isolated by a long telephoto and weather, melancholy and hushed, closer to poetry than geography.",
  "slots": [
    {
      "id": "weather",
      "ref": "atmosphere/weather",
      "label": "Weather",
      "default": "dense-mist"
    },
    {
      "id": "framing",
      "ref": "composition/vista",
      "label": "Composition",
      "default": "lone-element"
    }
  ],
  "variants": [
    {
      "name": "woodland",
      "label": "Woodland",
      "slots": [
        {
          "id": "scene",
          "ref": "nature/forest",
          "label": "The Scene",
          "emphasis": 1.25
        }
      ]
    },
    {
      "name": "meadow",
      "label": "Meadow & grassland",
      "slots": [
        {
          "id": "scene",
          "ref": "nature/grassland",
          "label": "The Scene",
          "emphasis": 1.25
        }
      ]
    },
    {
      "name": "flora",
      "label": "Flora close study",
      "slots": [
        {
          "id": "scene",
          "ref": "nature/flora",
          "label": "The Scene",
          "emphasis": 1.25
        }
      ]
    },
    {
      "name": "wetland",
      "label": "Wetland",
      "slots": [
        {
          "id": "scene",
          "ref": "nature/wetland",
          "label": "The Scene",
          "emphasis": 1.25
        }
      ]
    }
  ],
  "variant_default": "random",
  "order": ["@variant", "weather", "framing"],
  "suffix": "Quiet Rendering: (layers dissolving into weather:1.2), the muted pastel palette of overcast professional negative film, one element allowed to matter, the frame holding its breath.",
  "negative": "watermark, text, oversaturation, busy composition, people",
  "render": {
    "format": "string_labeled",
    "labeled_line": "{label}: {text}",
    "block_joiner": "\n"
  }
}
